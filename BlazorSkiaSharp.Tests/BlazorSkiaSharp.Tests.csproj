<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSkiaSharp\BlazorSkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MinimapSettingsStore and GraphSurfaceInput take an IJSRuntime, which lives in
         Microsoft.AspNetCore.App rather than in the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
